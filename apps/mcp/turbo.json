{
  "$schema": "https://turborepo.dev/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/skills/nuvui/**",
        "$TURBO_ROOT$/apps/showcase/src/blocks/**",
        "$TURBO_ROOT$/apps/showcase/src/charts/**",
        "$TURBO_ROOT$/apps/showcase/src/lib/charts.ts",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/CHANGELOG.md",
        "$TURBO_ROOT$/.changeset/*.md"
      ]
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/skills/nuvui/**",
        "$TURBO_ROOT$/apps/showcase/src/blocks/**",
        "$TURBO_ROOT$/apps/showcase/src/charts/**",
        "$TURBO_ROOT$/apps/showcase/src/lib/charts.ts",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/CHANGELOG.md",
        "$TURBO_ROOT$/.changeset/*.md"
      ]
    }
  }
}
