{
  "name": "@nuvui/date-picker",
  "version": "0.0.0",
  "description": "A calendar, a date field and a date range field for @nuvui/react, built on react-day-picker.",
  "license": "MIT",
  "author": "Nuvraxis",
  "homepage": "https://nuvui.nuvraxis.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuvraxis/nuvui.git",
    "directory": "packages/date-picker"
  },
  "bugs": {
    "url": "https://github.com/Nuvraxis/nuvui/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./calendar": {
      "import": {
        "types": "./dist/components/calendar/index.d.ts",
        "default": "./dist/components/calendar/index.js"
      },
      "require": {
        "types": "./dist/components/calendar/index.d.cts",
        "default": "./dist/components/calendar/index.cjs"
      }
    },
    "./date-picker": {
      "import": {
        "types": "./dist/components/date-picker/index.d.ts",
        "default": "./dist/components/date-picker/index.js"
      },
      "require": {
        "types": "./dist/components/date-picker/index.d.cts",
        "default": "./dist/components/date-picker/index.cjs"
      }
    },
    "./locale": {
      "import": {
        "types": "./dist/locale.d.ts",
        "default": "./dist/locale.js"
      },
      "require": {
        "types": "./dist/locale.d.cts",
        "default": "./dist/locale.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./css/*.css": "./dist/css/*.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/check-dist.mjs",
    "dev": "tsdown --watch src",
    "lint": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && pnpm pack --out node_modules/.cache/attw/package.tgz && attw node_modules/.cache/attw/package.tgz",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@nuvui/react": "workspace:^0.0.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "date-fns": "^4.4.0",
    "react-day-picker": "^10.0.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@nuvui/react": "workspace:*",
    "@nuvui/tooling": "workspace:*",
    "@nuvui/typescript-config": "workspace:*",
    "@size-limit/preset-small-lib": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "axe-core": "catalog:",
    "playwright": "catalog:",
    "publint": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sass-embedded": "catalog:",
    "size-limit": "catalog:",
    "stylelint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "vitest-browser-react": "catalog:"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
