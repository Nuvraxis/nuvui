{
  "name": "@nuvui/react",
  "version": "0.0.0",
  "description": "React components built on Radix UI primitives, styled with SCSS and BEM class names.",
  "license": "MIT",
  "author": "Nuvraxis",
  "homepage": "https://nuvui.nuvraxis.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuvraxis/nuvui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Nuvraxis/nuvui/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./accordion": {
      "import": {
        "types": "./dist/components/accordion/index.d.ts",
        "default": "./dist/components/accordion/index.js"
      },
      "require": {
        "types": "./dist/components/accordion/index.d.cts",
        "default": "./dist/components/accordion/index.cjs"
      }
    },
    "./button": {
      "import": {
        "types": "./dist/components/button/index.d.ts",
        "default": "./dist/components/button/index.js"
      },
      "require": {
        "types": "./dist/components/button/index.d.cts",
        "default": "./dist/components/button/index.cjs"
      }
    },
    "./checkbox": {
      "import": {
        "types": "./dist/components/checkbox/index.d.ts",
        "default": "./dist/components/checkbox/index.js"
      },
      "require": {
        "types": "./dist/components/checkbox/index.d.cts",
        "default": "./dist/components/checkbox/index.cjs"
      }
    },
    "./dialog": {
      "import": {
        "types": "./dist/components/dialog/index.d.ts",
        "default": "./dist/components/dialog/index.js"
      },
      "require": {
        "types": "./dist/components/dialog/index.d.cts",
        "default": "./dist/components/dialog/index.cjs"
      }
    },
    "./dropdown-menu": {
      "import": {
        "types": "./dist/components/dropdown-menu/index.d.ts",
        "default": "./dist/components/dropdown-menu/index.js"
      },
      "require": {
        "types": "./dist/components/dropdown-menu/index.d.cts",
        "default": "./dist/components/dropdown-menu/index.cjs"
      }
    },
    "./popover": {
      "import": {
        "types": "./dist/components/popover/index.d.ts",
        "default": "./dist/components/popover/index.js"
      },
      "require": {
        "types": "./dist/components/popover/index.d.cts",
        "default": "./dist/components/popover/index.cjs"
      }
    },
    "./select": {
      "import": {
        "types": "./dist/components/select/index.d.ts",
        "default": "./dist/components/select/index.js"
      },
      "require": {
        "types": "./dist/components/select/index.d.cts",
        "default": "./dist/components/select/index.cjs"
      }
    },
    "./switch": {
      "import": {
        "types": "./dist/components/switch/index.d.ts",
        "default": "./dist/components/switch/index.js"
      },
      "require": {
        "types": "./dist/components/switch/index.d.cts",
        "default": "./dist/components/switch/index.cjs"
      }
    },
    "./tabs": {
      "import": {
        "types": "./dist/components/tabs/index.d.ts",
        "default": "./dist/components/tabs/index.js"
      },
      "require": {
        "types": "./dist/components/tabs/index.d.cts",
        "default": "./dist/components/tabs/index.cjs"
      }
    },
    "./toast": {
      "import": {
        "types": "./dist/components/toast/index.d.ts",
        "default": "./dist/components/toast/index.js"
      },
      "require": {
        "types": "./dist/components/toast/index.d.cts",
        "default": "./dist/components/toast/index.cjs"
      }
    },
    "./tooltip": {
      "import": {
        "types": "./dist/components/tooltip/index.d.ts",
        "default": "./dist/components/tooltip/index.js"
      },
      "require": {
        "types": "./dist/components/tooltip/index.d.cts",
        "default": "./dist/components/tooltip/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./base.css": "./dist/base.css",
    "./css/*.css": "./dist/css/*.css",
    "./scss": "./dist/scss/styles/index.scss",
    "./scss/mixins": "./dist/scss/styles/_mixins.scss",
    "./scss/tokens": "./dist/scss/styles/tokens.scss",
    "./scss/base": "./dist/scss/styles/base.scss",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/check-dist.mjs",
    "dev": "tsdown --watch src",
    "lint": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && pnpm pack --out node_modules/.cache/attw/package.tgz && attw node_modules/.cache/attw/package.tgz"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nuvui/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "^5.0.3",
    "axe-core": "^4.13.0",
    "playwright": "catalog:",
    "publint": "^0.3.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sass-embedded": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16"
  }
}
