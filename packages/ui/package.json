{
  "name": "@nuvui/react",
  "version": "0.0.0",
  "description": "React components built on Radix UI primitives, styled with SCSS and BEM class names.",
  "license": "MIT",
  "author": "Nuvraxis",
  "homepage": "https://nuvui.nuvraxis.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nuvraxis/nuvui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/Nuvraxis/nuvui/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/check-dist.mjs",
    "dev": "tsdown --watch",
    "lint": "stylelint \"src/**/*.scss\" --allow-empty-input",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:package": "publint && pnpm pack --out node_modules/.cache/attw/package.tgz && attw node_modules/.cache/attw/package.tgz"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@nuvui/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser-playwright": "^5.0.3",
    "axe-core": "^4.13.0",
    "playwright": "catalog:",
    "publint": "^0.3.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "tsdown": "0.23.0",
    "typescript": "catalog:",
    "vitest": "^5.0.3",
    "vitest-browser-react": "^2.3.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
